#include<iostream>
using namespace std;

class Book {
public:
    string title, author;
    int ISBN;

    void setDetails(string &title, string &author, int &ISBN) {
        this->title = title;
        this->author = author;
        this->ISBN = ISBN;
    }
};

class Library {
    Book books[100];
    int count;

public:
    Library() { count = 0; }

    bool addNewBook(string &title, string &author, int &ISBN) {
        if(count >= 100) return false;
        books[count].setDetails(title, author, ISBN);
        count++;
        return true;
    }

    bool removeBooks(int &ISBN);

    void displayDetails() {
        cout << "\nLibrary Books:\n";
        for(int i=0; i<count; i++) {
            cout << books[i].title << " "
                 << books[i].author << " "
                 << books[i].ISBN << endl;
        }
    }
};

bool Library::removeBooks(int &ISBN) {
    for(int i=0; i<count; i++) {
        if(books[i].ISBN == ISBN) {
            books[i] = books[count-1];
            count--;
            return true;
        }
    }
    return false;
}

int main() {
    Library l;

    string t, a;
    int id;

    for(int i=0; i<5; i++) {
        cout << "\nEnter title, author, ISBN: ";
        cin >> t >> a >> id;
        l.addNewBook(t, a, id);
    }

    l.displayDetails();

    cout << "\nEnter ISBN to remove: ";
    cin >> id;
    l.removeBooks(id);

    cout << "\nAfter removal:\n";
    l.displayDetails();

    return 0;
}

