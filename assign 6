#include<iostream>
using namespace std;

class Book {
public:
    string title, author;
    int ISBN;

    Book() {
        this->title = "";
        this->author = "";
        this->ISBN = 0;
    }

    Book(string title, string author, int ISBN) {
        this->title = title;
        this->author = author;
        this->ISBN = ISBN;
    }

    Book(const Book &b) {
        this->title = b.title;
        this->author = b.author;
        this->ISBN = b.ISBN;
    }

    void display() {
        cout << title << " " << author << " " << ISBN << endl;
    }
};

int main() {

    Book b1[3] = {
        Book("A","X",1),
        Book("B","Y",2),
        Book("C","Z",3)
    };

    for(int i=0;i<3;i++)
        b1[i].display();

    int n = 2;
    Book *b2 = new Book[n];

    b2[0] = Book("D","P",4);
    b2[1] = Book("E","Q",5);

    for(int i=0;i<n;i++)
        b2[i].display();

    delete[] b2;

    return 0;
}

