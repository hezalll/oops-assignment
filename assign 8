using namespace std;

template <class T>
int linearSearch(T arr[], int n, T key) {
    for(int i = 0; i < n; i++) {
        if(arr[i] == key)
            return i;
    }
    return -1;
}

int main() {
    double arr[] = {10, 20, 30, 40, 50};
    cout << linearSearch(arr, 5, 30);
    return 0;
}

