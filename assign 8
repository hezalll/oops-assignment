#include <iostream>
using namespace std;

template <class T>
T findMin(T arr[], int n) {
    T min = arr[0];
    for(int i = 1; i < n; i++) {
        if(arr[i] < min)
            min = arr[i];
    }
    return min;
}

int main() {
    double arr[] = {4, 2, 7, 1, 9};
    cout <<"Minimum element: "<< findMin(arr, 5);
    return 0;
}

