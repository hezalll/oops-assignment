#include <iostream>
using namespace std;

template <class T>
class Stack {
    T arr[100];
    int top;
public:
    Stack() { top = -1; }
    void push(T x) {
        if(top == 99) return;
        arr[++top] = x;
    }
    T pop() {
        if(top == -1) return T();
        return arr[top--];
    }
};

int main() {
    Stack<int> s;
    s.push(10);
    s.push(20);
    cout << s.pop() << " " << s.pop();
    return 0;
}

