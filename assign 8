#include<iostream>
using namespace std;

template <class T>
class Queue {
    T arr[100];
    int front, rear;

public:
    Queue() { front = rear = -1; }

    void enqueue(T x) {
        arr[++rear] = x;
    }

    void dequeue() {
        if(front < rear)
            cout << arr[++front] << endl;
    }
};

int main() {
    Queue<int> q;
    q.enqueue(10);
    q.enqueue(20);
    q.dequeue();
    return 0;
}

