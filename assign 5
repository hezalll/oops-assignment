3. #include <iostream>
using namespace std;

class Base {
public:
    int a;
protected:
    int b;
private:
    int c;
public:
    Base() {
        a = 1; b = 2; c = 3;
    }
};

class PublicDerived : public Base {
public:
    void show() {
        cout << a << " " << b << endl;
    }
};

class ProtectedDerived : protected Base {
public:
    void show() {
        cout << a << " " << b << endl;
    }
};

class PrivateDerived : private Base {
public:
    void show() {
        cout << a << " " << b << endl;
    }
};

int main() {
    PublicDerived p;
    ProtectedDerived pr;
    PrivateDerived pv;
    p.show();
    pr.show();
    pv.show();
    return 0;
}

