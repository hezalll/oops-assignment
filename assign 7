float area(float a) {
    return 1.732/4*a*a;
}

float area(float a,float b,float c) {
    float s=(a+b+c)/2;
    return sqrt(s*(s-a)*(s-b)*(s-c));
}

int main(){
    cout<<area(4,5)<<endl;
    cout<<area(3)<<endl;
    cout<<area(3,4,5);
    return 0;
}

