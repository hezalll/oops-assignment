#include<iostream>
using namespace std;

class Polygon {
protected:
    int width, height;
public:
    void set_value(int w, int h) {
        width = w;
        height = h;
    }
    virtual int area() { return 0; }
};

class Rectangle : public Polygon {
public:
    int area() {
        return width * height;
    }
};

class Triangle : public Polygon {
public:
    int area() {
        return width * height / 2;
    }
};

int main() {
    Polygon *p;
    Rectangle r;
    Triangle t;

    r.set_value(4,5);
    t.set_value(4,5);

    p = &r;
    cout << p->area() << endl;

    p = &t;
    cout << p->area();

    return 0;
}

